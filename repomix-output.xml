    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header><h1>Order Management</h1></header>

  <section class="tab-shell">
    <nav class="tab-nav" aria-label="Application tabs">
      <button class="tab-btn is-active" data-tab="orders" type="button">Orders</button>
      <button class="tab-btn" data-tab="orders-aimode" type="button">Orders AI Mode</button>
      <button class="tab-btn" data-tab="orders-mcp" type="button">Orders MCP</button>
      <button class="tab-btn" data-tab="orders-rag" type="button">Orders RAG</button>
    </nav>

    <div class="tab-content">
      <iframe id="tab-frame-orders" class="tab-frame is-active" src="tabs/orders.html" title="Orders tab"></iframe>
      <iframe id="tab-frame-orders-aimode" class="tab-frame" src="tabs/orders-aimode.html" title="Orders AI Mode tab"></iframe>
      <iframe id="tab-frame-orders-mcp" class="tab-frame" src="tabs/orders-mcp.html" title="Orders MCP tab"></iframe>
      <iframe id="tab-frame-orders-rag" class="tab-frame" src="tabs/orders-rag.html" title="Orders RAG tab"></iframe>
    </div>
  </section>

  <script>
    const tabButtons = Array.from(document.querySelectorAll(".tab-btn"));

    const tabFrames = {};
    document.querySelectorAll(".tab-frame").forEach((frame) => {
      tabFrames[frame.id.replace("tab-frame-", "")] = frame;
    });

    function activateTab(tabName) {
      tabButtons.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.tab === tabName);
      });
      Object.entries(tabFrames).forEach(([name, frame]) => {
        frame.classList.toggle("is-active", name === tabName);
      });
      window.location.hash = tabName;
    }

    tabButtons.forEach((button) => {
      if (button.disabled) return;
      button.addEventListener("click", () => activateTab(button.dataset.tab));
    });

    const hashTab = window.location.hash.replace("#", "");
    activateTab(hashTab && tabFrames[hashTab] ? hashTab : "orders");
  </script>
</body>
</html>
