        extra_hosts:
            - "host.docker.internal:host-gateway"
        depends_on: [order-database]
        networks: [team-network]

    order-database:
        build: ./database
        ports: ["5012:5002"]
        volumes: [order-database-data:/app/data]
        networks: [team-network]

volumes:
    order-database-data:

networks:
  team-network:
    external: true
