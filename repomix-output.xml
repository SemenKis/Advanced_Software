<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>MCP</title>
<link rel="stylesheet" href="/css/styles.css">
<style>
  body { margin: 0; min-height: auto; background: transparent; }
  .app-shell { max-width: none; padding: 0; }
</style>
</head>
<body>
<main class="app-shell">
  <section class="card">
    <h2>MCP Mode</h2>
    <p style="color: var(--muted); margin-top: -0.3rem;">Controlled tools an agent can call, so each returns real inventory data, never a guess.</p>

    <div class="feature-toggle-row">
      <label class="toggle-switch" for="mcp-mode-toggle">
        <input id="mcp-mode-toggle" type="checkbox" checked>
        <span class="toggle-label">MCP Enabled</span>
      </label>
      <span id="mcp-mode-state" class="feature-state feature-on">ON</span>
    </div>

    <h3>product_count</h3>
    <div class="feature-actions">
      <button type="button" class="mcp-action" id="mcp-product-count-btn">Get Product Count</button>
    </div>

    <h3>products_by_category</h3>
    <form id="mcp-category-form" class="feature-form">
      <label for="mcp_category_name">Category name</label>
      <input id="mcp_category_name" name="category_name" type="text" placeholder="Example: Cleaning Supplies">
      <button type="submit" class="mcp-action">Run Tool</button>
    </form>

    <h3>low_stock_report</h3>
    <div class="feature-actions">
      <button type="button" class="mcp-action" id="mcp-low-stock-btn">Get Low Stock Report</button>
    </div>

    <h3>supplier_lookup</h3>
    <form id="mcp-supplier-form" class="feature-form">
      <label for="mcp_supplier_name">Supplier name</label>
      <input id="mcp_supplier_name" name="supplier_name" type="text" placeholder="Example: Protection Company">
      <button type="submit" class="mcp-action">Run Tool</button>
    </form>

    <div id="mcp-result" class="panel panel-mcp">MCP tool responses will appear here.</div>
  </section>
</main>

<script>
const BACKEND = "http://localhost:5001";
const mcpModeToggle = document.getElementById("mcp-mode-toggle");
const mcpModeState = document.getElementById("mcp-mode-state");
const mcpResultPanel = document.getElementById("mcp-result");
const MCP_STORAGE_KEY = "mcp_mode_enabled";

function isMcpEnabled() { return mcpModeToggle.checked; }

function renderMcpState() {
  mcpModeState.textContent = isMcpEnabled() ? "ON" : "OFF";
  mcpModeState.classList.toggle("feature-on", isMcpEnabled());
  mcpModeState.classList.toggle("feature-off", !isMcpEnabled());
}

function renderMcpDisabledMessage() {
  mcpResultPanel.innerHTML = "<p>MCP Mode is OFF. Enable MCP Mode to run MCP tools.</p>";
}

function saveMcpMode() { localStorage.setItem(MCP_STORAGE_KEY, String(isMcpEnabled())); }

function loadMcpMode() {
  const persisted = localStorage.getItem(MCP_STORAGE_KEY);
  mcpModeToggle.checked = persisted === null ? true : persisted === "true";
  renderMcpState();
}

mcpModeToggle.addEventListener("change", () => {
  saveMcpMode();
  renderMcpState();
  if (!isMcpEnabled()) renderMcpDisabledMessage();
});

async function callMcpTool(path, formData) {
  if (!isMcpEnabled()) {
    renderMcpDisabledMessage();
    return;
  }
  mcpResultPanel.innerHTML = "<p>Running tool...</p>";
  try {
    const response = await fetch(`${BACKEND}${path}`, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded", "X-MCP-Mode": "on" },
      body: formData || new URLSearchParams(),
    });
    mcpResultPanel.innerHTML = await response.text();
  } catch (error) {
    mcpResultPanel.innerHTML = `<p>Request failed.</p><pre>${error}</pre>`;
  }
}

document.getElementById("mcp-product-count-btn").addEventListener("click", () => {
  callMcpTool("/mcp/product-count");
});

document.getElementById("mcp-category-form").addEventListener("submit", (event) => {
  event.preventDefault();
  callMcpTool("/mcp/products-by-category", new URLSearchParams(new FormData(event.target)));
});

document.getElementById("mcp-low-stock-btn").addEventListener("click", () => {
  callMcpTool("/mcp/low-stock-report");
});

document.getElementById("mcp-supplier-form").addEventListener("submit", (event) => {
  event.preventDefault();
  callMcpTool("/mcp/supplier-lookup", new URLSearchParams(new FormData(event.target)));
});

loadMcpMode();
if (!isMcpEnabled()) renderMcpDisabledMessage();
</script>
</body>
</html>
</file>

