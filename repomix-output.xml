    <title>Orders</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&amp;family=IBM+Plex+Sans:wght@400;500;600&amp;family=IBM+Plex+Mono:wght@500&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
    <div class="menu">
      <h2>Menu</h2>
      
      <button class="btn primary" id="create-order-btn" commandfor="create-order-modal" command="show-modal">+ New order</button>
      
      <div class="search-order">
        <input type="number" id="search-order" placeholder="Search order by Id" required />
        <button type="submit" id="submit-search-order-btn">Search Order</button>
      </div>
    </div>
    <dialog id="create-order-modal">
      <form id="create-order-form">
