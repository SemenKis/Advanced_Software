    </dialog>
  </main>
   
  <button id="show-orders-btn">Show All Orders</button>
 
  <div id="orders-result"></div>

  <script>
    
    const createOrderBtn = document.getElementById('create-order-btn');
    const cancelOrderBtn = document.getElementById('cancel-order-btn');
    const createOrderModal = document.getElementById('create-order-modal');
    const searchOrderBtn = document.getElementById('submit-search-order-btn');
    createOrderBtn.addEventListener('click', () => {
        createOrderModal.showModal();
    });
    cancelOrderBtn.addEventListener('click', () => {
      document.getElementById("create-order-form").reset();  
      createOrderModal.close();
    });

    searchOrderBtn.addEventListener('click', () => {
      const orderId = document.getElementById("search-order").value.trim();
      getOrderById(parseInt(orderId, 10));
    })



    let currentOrders = [];
    document.getElementById("create-order-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const order_name = document.getElementById("order-name").value.trim();
      const order_address = document.getElementById("order-address").value.trim();
      const product_name = document.getElementById("product-name").value.trim();
      const quantity = document.getElementById("quantity").value.trim();
      const total_amount = document.getElementById("total-amount").value.trim();
 
      const res = await fetch("/api/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            order_name,
            order_address,
            product_name,
            quantity,
            total_amount,
          }),
      });
 
      const result = await res.json();
      e.target.reset();
      document.getElementById("quantity").value = 1;
      loadOrders();
    });
 
    document.getElementById("show-orders-btn").addEventListener("click", loadOrders);
 
    
    async function loadOrders() {
      const resultEl = document.getElementById("orders-result");
      resultEl.textContent = "Loading...";

      try {
        const res = await fetch("/api/orders");
        if (!res.ok) {
          throw new Error(`Request failed: ${res.status}`);
        }
        currentOrders = await res.json();
        renderOrders();
      } catch (err) {
        resultEl.textContent = "Failed to load orders.";
      }
    }

    async function getOrderById(id) {
      const resultEl = document.getElementById("orders-result");
      resultEl.textContent = "Loading...";

      try {
        const res = await fetch(`/api/orders/${id}`);
        if (!res.ok) {
          throw new Error(`Request failed: ${res.status}`);
        }
        currentOrder = await res.json();

        if (!currentOrder) {
          resultEl.textContent = `No order with ${id} available`;
        } else {
          renderOneOrder(currentOrder);
        }
      } catch (err) {
        resultEl.textContent = "Failed to load orders.";
      }
    }

    function renderOneOrder(order) {
      const resultEl = document.getElementById("orders-result");

      if (!order) {
        resultEl.textContent = "No order found with order id: " + order;
        return;
      }

      const container = document.createElement("div");
      container.appendChild(buildOrderRow(order));

      resultEl.replaceChildren(container);
    }

    function renderOrders() {
      const resultEl = document.getElementById("orders-result");

      if (!currentOrders.length) {
        resultEl.textContent = "No orders found.";
        return;
      }

      const container = document.createElement("div");

      currentOrders.forEach((order) => {
        container.appendChild(buildOrderRow(order));
      });

      resultEl.replaceChildren(container);
    }

    function buildOrderRow(order) {
      const row = document.createElement("div");
      row.className = "order-row";
      row.dataset.orderId = order.order_id;

      const label = order.order_ref || `#${order.order_id}`;
      const summary = document.createElement("div");
      summary.className = "order-field";
      summary.textContent =
        `${label} - ${order.order_name} - [${order.order_status}]`;
      row.appendChild(summary);

      const actions = document.createElement("div");
      actions.className = "order-actions";

      const viewBtn = document.createElement("button");
      viewBtn.textContent = "View";
      viewBtn.addEventListener("click", () => toggleView(row, order));

      const editBtn = document.createElement("button");
      editBtn.textContent = "Edit";
      editBtn.addEventListener("click", () => enterEditMode(row, order));

      const deleteBtn = document.createElement("button");
      deleteBtn.textContent = "Delete";
      deleteBtn.addEventListener("click", () => deleteOrder(order.order_id));

      actions.appendChild(viewBtn);
      actions.appendChild(editBtn);
      actions.appendChild(deleteBtn);
      row.appendChild(actions);

      return row;
    }

    function toggleView(row, order) {
      const existing = row.nextElementSibling;
      if (existing && existing.classList.contains("order-detail")) {
        existing.remove();
        return;
      }

      const detail = document.createElement("div");
      detail.className = "order-detail";
      detail.innerHTML = `
        <div><strong>Order ID:</strong> ${order.order_id}</div>
        <div><strong>Reference:</strong> ${order.order_ref || "n/a"}</div>
        <div><strong>Name:</strong> ${order.order_name}</div>
        <div><strong>Address:</strong> ${order.order_address}</div>
        <div><strong>Status:</strong> ${order.order_status}</div>
        <div><strong>Product:</strong> ${order.product_name}</div>
        <div><strong>Quantity:</strong> ${order.quantity}</div>
        <div><strong>Total:</strong> $${order.total_amount}</div>
      `;
      row.after(detail);
    }

    function enterEditMode(row, order) {
      row.classList.add("editing");
      row.innerHTML = "";

      const fields = {
        order_name: order.order_name,
        order_address: order.order_address,
        order_status: order.order_status,
        product_name: order.product_name,
        quantity: order.quantity,
        total_amount: order.total_amount,
      };

      const inputs = {};
      Object.entries(fields).forEach(([key, value]) => {
        const input = document.createElement("input");
        input.value = value;
        input.dataset.field = key;
        inputs[key] = input;
        row.appendChild(input);
      });

      const actions = document.createElement("div");
      actions.className = "order-actions";

      const saveBtn = document.createElement("button");
      saveBtn.textContent = "Save";
      saveBtn.addEventListener("click", () => saveOrder(order.order_id, inputs));

      const cancelBtn = document.createElement("button");
      cancelBtn.textContent = "Cancel";
      cancelBtn.addEventListener("click", renderOrders);

      actions.appendChild(saveBtn);
      actions.appendChild(cancelBtn);
      row.appendChild(actions);
    }

    async function saveOrder(orderId, inputs) {
      const updated = {
        order_name: inputs.order_name.value.trim(),
        order_address: inputs.order_address.value.trim(),
        order_status: inputs.order_status.value.trim() || "pending",
        product_name: inputs.product_name.value.trim(),
        quantity: inputs.quantity.value.trim(),
        total_amount: inputs.total_amount.value.trim(),
      };

      try {
        const res = await fetch(`/api/orders/${orderId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(updated),
        });
        if (!res.ok) {
          throw new Error(`Request failed: ${res.status}`);
        }
        loadOrders();
      } catch (err) {
        alert("Failed to update order.");
      }
    }

    async function deleteOrder(orderId) {
      if (!confirm(`Delete order ${orderId}?`)) {
        return;
      }

      try {
        const res = await fetch(`/api/orders/${orderId}`, { method: "DELETE" });
        if (!res.ok) {
          throw new Error(`Delete order request failed: ${res.status}`);
        }
        loadOrders();
      } catch (err) {
        alert("Failed to delete order.");
      }
    }
  </script>

</body>
</html>
</file>

