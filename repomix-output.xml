<file path="student-2-yuting/frontend/templates/_packing_rows.html">
{% for it in items %}
<tr>
    <td>{{ it.id }}</td>
    <td>{{ it.order_id }}</td>
    <td>{{ it.items_json }}</td>
    <td>
        <form class="inline" hx-post="/packing-lists/{{ it.id }}/update" hx-target="#packing-rows" hx-swap="innerHTML">
             <input type="hidden" name="order_id" value="{{ it.order_id }}">
             <input type="hidden" name="items_json" value='{{ it.items_json }}'>
             <select name="status">
                <option {% if it.status == 'pending' %}selected{% endif %}>pending</option>
                <option {% if it.status == 'packed' %}selected{% endif %}>packed</option>
                <option {% if it.status == 'shipped' %}selected{% endif %}>shipped</option>
             </select>
             <button type="submit">Update</button>
        </form>
    </td>
    <td>
        <form class="inline" hx-delete="/packing-lists/{{ it.id }}/delete" hx-target="#packing-rows" hx-swap="innerHTML" hx-confirm="Delete?">
            <button type="submit">Delete</button>
        </form>
    </td>
</tr>
{% endfor %}
</file>

<file path="student-2-yuting/frontend/templates/_shipping_rows.html">
{% for it in items %}
<tr>
    <td>{{ it.id }}</td>
    <td>{{ it.order_id }}</td>
    <td>{{ it.packing_list_id }}</td>
    <td>{{ it.task_type }}</td>
    <td>{{ it.assigned_to }}</td>
    <td><strong>{{ it.priority }}</strong></td>
    <td>
        <form class="inline" hx-post="/shipping-tasks/{{ it.id }}/update" hx-target="#shipping-rows" hx-swap="innerHTML">
            <input type="hidden" name="order_id" value="{{ it.order_id }}">
            <input type="hidden" name="packing_list_id" value="{{ it.packing_list_id }}">
            <input type="hidden" name="task_type" value="{{ it.task_type }}">
            <input type="hidden" name="assigned_to" value="{{ it.assigned_to }}">
            <input name="priority" value="{{ it.priority }}" size="3">
            <select name="status">
                <option {% if it.status == 'pending' %}selected{% endif %}>pending</option>
                <option {% if it.status == 'in_progress' %}selected{% endif %}>in_progress</option>
                <option {% if it.status == 'completed' %}selected{% endif %}>completed</option>
            </select>
            <button type="submit">Update</button>
        </form>
    </td>
    <td>{{ it.bottleneck_risk }}</td>
    <td>
        <form class="inline" hx-delete="/shipping-tasks/{{ it.id }}/delete" hx-target="#shipping-rows" hx-swap="innerHTML" hx-confirm="Delete?">
            <button type="submit">Delete</button>
        </form>
    </td>
</tr>
{% endfor %}
</file>

<file path="student-2-yuting/frontend/templates/base.html">
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Warehouse Management - Student 2 Yuting</title>
    <script src="/static/htmx.min.js"></script>
    <style>
        body { font-family: sans-serif; margin: 2rem; color: #032c24; background-color: #d3eaf8; }
        table { border-collapse: collapse; width: 100%; margin-top: 1rem; background-color: #ffffff; }
        th, td { border: 1px solid #376f7e; padding: 10px 14px; text-align: left; font-size: 0.9rem; }
        th { background-color: #a5d5e9; color: #032c24; }
        nav { background-color: #032c24; padding: 12px 20px; border-radius: 8px; }
        nav a { margin-right: 1.2rem; text-decoration: none; font-weight: bold; color: #d3eaf8; }
        nav a:hover { color: #a5d5e9; }

        .ai-button {
            background-color: #032c24;
            color: #d3eaf8;
            border: none;
            padding: 10px 20px;
