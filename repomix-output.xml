  populateSelect(document.getElementById("add_supplier_id"), `${BACKEND}/suppliers/options`, "");
  populateSelect(document.getElementById("upd_category_id"), `${BACKEND}/categories/options`, "");
  populateSelect(document.getElementById("upd_supplier_id"), `${BACKEND}/suppliers/options`, "");
}
initDropdowns();

function loadProducts() {
  const params = new URLSearchParams();
  const search = document.getElementById("search-input").value.trim();
  const category = document.getElementById("category-filter").value;
  const supplier = document.getElementById("supplier-filter").value;
  const sortBy = document.getElementById("sort-by").value;
  const sortDir = document.getElementById("sort-dir").value;
  if (search) params.set("search", search);
  if (category) params.set("category_id", category);
