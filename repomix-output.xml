FROM nginx:alpine

# Static assets
COPY templates/ /usr/share/nginx/html/
COPY css/ /usr/share/nginx/html/css/

# Reverse-proxy config (proxies /api/ to order-service)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
</file>

<file path="student-1-bea/frontend/nginx.conf">
server {
    listen 80;
 
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
 
    location /api/ {
        proxy_pass http://order-backend:5001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
</file>

<file path="student-1-bea/docker-compose.yml">
services:
    order-frontend:
        build: ./frontend
        ports: ["8082:80"]
        depends_on: [order-backend]
        networks: [team-network]

    order-backend:
        build: ./backend
        ports: ["5011:5001"]
        environment:
            DATABASE_SERVICE_URL: http://order-database:5002
            OLLAMA_BASE_URL: http://host.docker.internal:11434/v1
